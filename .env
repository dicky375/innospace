# ============================================
# INNOSPACE PLATFORM - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# ============================================

# ===== SERVER CONFIGURATION =====
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost:8080,

# ===== DATABASE (PostgreSQL) =====
# For Render.com, this will be provided automatically
# For local development:
# DATABASE_URL=postgresql://username:password@localhost:5432/innospace
DATABASE_URL=postgresql://dicky:postgres@localhost:5432/innospace

# Alternative: Individual credentials (if not using URL)
# DB_NAME=innospace
# DB_USER=postgres
# DB_PASS=your_password
# DB_HOST=localhost
# DB_PORT=5432

# ===== REDIS CACHE =====
# For Render.com Redis or Upstash
REDIS_URL=redis://localhost:6379

# For Upstash (with TLS): rediss://default:password@host:port

# ===== JWT AUTHENTICATION =====
# Generate these with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=64c9cade2d54638aaf3c99540b58f1ff09f6ee584716a407b4718b4e22e92db6a1107448a28b8a3c8336f1ca9d092b8769dae810509fab718d100223bf315c26
JWT_REFRESH_SECRET=64c9cade2d54638aaf3c99540b58f1ff09f6ee584716a407b4718b4e22e92db6a1107448a28b8a3c8336f1ca9d092b8769dae810509fab718d100223bf315c26
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=7d

# ===== PAYSTACK PAYMENT =====
# Get these from your Paystack dashboard
PAYSTACK_SECRET_KEY=sk_test_60608b3d3bcadd0d00eaa18ef71dbae7b75dcb51
PAYSTACK_PUBLIC_KEY=pk_test_88eb0d0fb4a3db0fc3dab0457c806b20d9beaa5f
PAYSTACK_CALLBACK_URL==http://localhost:5173/payment/verify
# Webhook URL for Paystack: https://your-domain.com/api/webhook/paystack

# ===== COMMISSION SETTINGS =====
# Default commission rate (as decimal: 0.10 = 10%)
DEFAULT_COMMISSION_RATE=0.10
DEFAULT_AFFILIATE_COMMISSION=35000

# ===== INTERNAL SERVICE SECURITY =====
# Used for service-to-service communication (not needed in monolith, but keep for future)
INTERNAL_SERVICE_SECRET=your_internal_service_secret_key

# ===== FILE UPLOADS =====
# Maximum file size in bytes (10MB = 10485760)
UPLOAD_MAX_SIZE=10485760
# Allowed file types
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ===== EMAIL/SMTP (for notifications & verification) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@innospace.com
# Frontend URL for email links
FRONTEND_URL=https://localhost:5173

# ===== ADMIN SEEDING =====
# Used when running: npm run seed:admin
ADMIN_EMAIL=admin@innospace.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Super Admin
ADMIN_PHONE=08012345678

